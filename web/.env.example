# Copy to .env.local and adjust. Defaults below work for local dev out of the box.

# --- Odoo connection (server-side only; never exposed to the browser) ---
ODOO_URL=http://localhost:8069
ODOO_DB=nadi
ODOO_USER=admin
# Dev: Odoo's default admin password is "admin". Production: use a generated API key.
ODOO_API_KEY=admin
# false → the app falls back to lib/data.ts mocks (useful offline)
USE_ODOO=true

# --- Auth ---
# CHANGE THIS to a long random string. Signs the session JWTs.
AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars
# Dev-only: echo the OTP code in the API response so login works without SMTP.
# Set to false in production.
AUTH_DEV_ECHO=true
# Keep false so real sessions are required.
AUTH_DEV_FALLBACK=false

# --- Payments (Midtrans Snap) ---
# Leave BOTH blank to use the built-in simulated gateway (demo works with no account).
# For the real sandbox popup with test cards, get keys at
# https://dashboard.sandbox.midtrans.com → Settings → Access Keys.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
