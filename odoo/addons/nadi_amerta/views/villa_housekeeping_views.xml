<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hk_task_tree" model="ir.ui.view">
        <field name="name">villa.housekeeping.task.tree</field>
        <field name="model">villa.housekeeping.task</field>
        <field name="arch" type="xml">
            <tree>
                <field name="product_id"/>
                <field name="room_id"/>
                <field name="task_type"/>
                <field name="assignee_id"/>
                <field name="due"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_hk_task_form" model="ir.ui.view">
        <field name="name">villa.housekeeping.task.form</field>
        <field name="model">villa.housekeeping.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_advance" type="object" string="Advance"
                            class="btn-secondary" invisible="state == 'done'"/>
                    <button name="action_submit" type="object" string="Submit report"
                            class="btn-primary" invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="room_id"/>
                            <field name="reservation_id"/>
                            <field name="task_type"/>
                        </group>
                        <group>
                            <field name="assignee_id"/>
                            <field name="due"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checklist" name="checklist">
                            <field name="item_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="done" widget="boolean_toggle"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Completion report" name="report">
                            <group>
                                <field name="conclusion" placeholder="Notes for HR / back office…"/>
                                <field name="submitted_at" readonly="1"/>
                                <field name="submitted_by_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hk_task" model="ir.actions.act_window">
        <field name="name">Housekeeping</field>
        <field name="res_model">villa.housekeeping.task</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
