<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_guest_request_tree" model="ir.ui.view">
        <field name="name">villa.guest.request.tree</field>
        <field name="model">villa.guest.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="request_type"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="priority"/>
                <field name="state" widget="badge"
                       decoration-danger="request_type == 'complaint' and state == 'open'"
                       decoration-success="state == 'resolved'"/>
            </tree>
        </field>
    </record>

    <record id="view_guest_request_form" model="ir.ui.view">
        <field name="name">villa.guest.request.form</field>
        <field name="model">villa.guest.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_take" type="object" string="Take it"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_resolve" type="object" string="Resolve"
                            invisible="state == 'resolved'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="request_type"/>
                            <field name="partner_id"/>
                            <field name="reservation_id"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="assignee_id"/>
                        </group>
                    </group>
                    <field name="detail"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_guest_request" model="ir.actions.act_window">
        <field name="name">Guest Requests</field>
        <field name="res_model">villa.guest.request</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
