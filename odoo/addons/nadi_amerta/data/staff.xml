<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Note #6 — one staff account per job position. Each is an internal user
         (base.group_user) plus the matching Nadi Amerta role group, so signing in
         at /staff-login as any of these shows exactly that job's consoles.
         Demo credentials: login = the email below, password = the same as login. -->

    <record id="user_front_office" model="res.users">
        <field name="name">Kadek Front Office</field>
        <field name="login">frontoffice@nadiamerta.local</field>
        <field name="password">frontoffice@nadiamerta.local</field>
        <field name="x_job_title">Front Office Agent</field>
        <field name="groups_id" eval="[(4, ref('base.group_user')), (4, ref('nadi_amerta.group_nadi_front_office'))]"/>
    </record>

