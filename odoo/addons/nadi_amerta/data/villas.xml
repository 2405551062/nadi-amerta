<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The 8 villas as regular catalog data (product.template, x_kind=villa).
         Loads on module install/update regardless of the demo flag.
         Prices mirror web/lib/data.ts so the two data sets line up. -->

    <record id="villa_tirta" model="product.template">
        <field name="name">Villa Tirta</field>
        <field name="type">service</field>
        <field name="categ_id" ref="product_category_villa"/>
        <field name="list_price">8500000</field>
        <field name="x_kind">villa</field>
        <field name="x_slug">villa-tirta</field>
        <field name="x_villa_type">Riverside Collection</field>
        <field name="x_view">river</field>
        <field name="x_bedrooms">1</field>
        <field name="x_capacity">2</field>
        <field name="x_size_m2">150</field>
        <field name="x_min_stay">2</field>
        <field name="x_availability">occupied</field>
        <field name="x_excerpt">One-bedroom sanctuary suspended over the Ayung gorge.</field>
    </record>

