<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Module category (ERD RBAC → res.groups) -->
    <record id="module_category_nadi" model="ir.module.category">
        <field name="name">Nadi Amerta</field>
        <field name="sequence">20</field>
    </record>

    <!-- Staff role groups, one per BPMN lane / Use-Case actor -->
    <record id="group_nadi_front_office" model="res.groups">
        <field name="name">Front Office</field>
        <field name="category_id" ref="module_category_nadi"/>
    </record>

    <record id="group_nadi_housekeeping" model="res.groups">
        <field name="name">Housekeeping</field>
        <field name="category_id" ref="module_category_nadi"/>
    </record>

    <record id="group_nadi_fnb" model="res.groups">
        <field name="name">Food &amp; Beverage</field>
        <field name="category_id" ref="module_category_nadi"/>
    </record>

    <record id="group_nadi_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="category_id" ref="module_category_nadi"/>
    </record>

    <record id="group_nadi_back_office" model="res.groups">
        <field name="name">Back Office</field>
        <field name="category_id" ref="module_category_nadi"/>
    </record>

    <!-- General Manager implies every other role -->
    <record id="group_nadi_manager" model="res.groups">
        <field name="name">General Manager</field>
        <field name="category_id" ref="module_category_nadi"/>
        <field name="implied_ids" eval="[(4, ref('group_nadi_front_office')),
                                          (4, ref('group_nadi_housekeeping')),
                                          (4, ref('group_nadi_fnb')),
                                          (4, ref('group_nadi_finance')),
                                          (4, ref('group_nadi_back_office'))]"/>
    </record>

</odoo>
